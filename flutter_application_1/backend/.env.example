# Bu dosyayi .env olarak kopyalayip kendi degerlerinizi girin: cp .env.example .env
# .env dosyasi git'e commit edilmez (.gitignore'da).

# JWT icin gizli anahtar. Production'da mutlaka rastgele, uzun bir deger belirleyin.
# Ornek uretmek icin: python -c "import secrets; print(secrets.token_hex(32))"
# Bos birakilirsa backend, gelistirme icin otomatik bir anahtar uretip
# backend/.jwt_secret dosyasina kaydeder (production icin uygun degildir).
JWT_SECRET=

